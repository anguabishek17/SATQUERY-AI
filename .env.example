# SatQuery AI Environment Configuration Template
# Copy this file to .env or backend/.env and populate with your keys.

# Google Gemini API Key for Evidence-Grounded AI Reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Low confidence threshold for flagging analysis results (optional, default 0.55)
LOW_CONFIDENCE_THRESHOLD=0.55

# Data directory path (optional, defaults to backend/data)
DATA_DIR=backend/data
